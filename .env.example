# Скопируйте в .env и заполните. Имена переменных должны совпадать с
# полями Settings в src/app/services/backend/app/core/config.py —
# pydantic-settings не подскажет опечатку, а молча возьмёт значение
# по умолчанию.

# ── База данных ───────────────────────────────────────────────────────────
# Либо один DATABASE_URL (его Render подставляет сам из pgsql), либо набор
# POSTGRES_* для локального docker compose.
# DATABASE_URL=postgresql+psycopg://root:123456@localhost:5432/robotics
POSTGRES_USER=root
POSTGRES_PASSWORD=123456
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=robotics

# ── Безопасность ──────────────────────────────────────────────────────────
# В продакшене обязательно задаётся: иначе токены подписываются
# опубликованным значением по умолчанию.
# SECRET_KEY=сгенерируйте случайную строку
# ACCESS_TOKEN_TTL_MINUTES=720
# REFRESH_TOKEN_TTL_DAYS=30

# ── CORS ──────────────────────────────────────────────────────────────────
# Дополнительные origin'ы через запятую.
# FRONTEND_ORIGINS=https://app.onrender.com,https://my-domain.ru
